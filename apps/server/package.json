{
  "name": "@magnetosphere/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/node.ts",
    "test": "vitest run",
    "test:both-runtimes": "vitest run --config vitest.both-runtimes.config.ts",
    "test:db": "node scripts/test-db.mjs",
    "typecheck": "tsc --noEmit",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "dry-run:all": "pnpm -C ../web build && wrangler deploy --dry-run --env d1 --outdir \"${TMPDIR:-/tmp}/mg-dry-run/d1\" && wrangler deploy --dry-run --env mysql --outdir \"${TMPDIR:-/tmp}/mg-dry-run/mysql\" && wrangler deploy --dry-run --env pg --outdir \"${TMPDIR:-/tmp}/mg-dry-run/pg\"",
    "test:workers": "vitest run --config vitest.workers.config.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.1",
    "@magnetosphere/auth": "workspace:*",
    "@magnetosphere/db": "workspace:*",
    "@magnetosphere/omniroute": "workspace:*",
    "@magnetosphere/runtime": "workspace:*",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.8"
  },
  "devDependencies": {
    "@libsql/client": "0.18.0",
    "@types/node": "24.13.6",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "wrangler": "4.115.0"
  }
}
