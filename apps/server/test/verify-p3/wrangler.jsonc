{
  // 3단계 확인 항목 V29~V32 의 D1 시험 Worker (M0). 배포하지 않는다. 지금 구성의 Better Auth 를 시험 구성마다 로컬 D1 위에 올린다 (worker.ts).
  // 마이그레이션은 시험이 wrangler d1 migrations apply --local 로 적용한다.
  "name": "mg-server-verify-p3",
  "main": "./worker.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "mg-server-verify-p3", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../../../packages/db/migrations/sqlite" }
  ]
}
