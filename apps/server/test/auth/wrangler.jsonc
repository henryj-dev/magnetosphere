{
  // TC-SEC.2.a 의 D1 시험 Worker. 배포하지 않는다. 실제 createAuth 를 로컬 D1 에 붙이고, 메일은 isolate 안 outbox 에 모은다 (reset-worker.ts).
  // 마이그레이션은 시험이 wrangler d1 migrations apply --local 로 적용한다.
  "name": "mg-server-auth-test",
  "main": "./reset-worker.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "mg-server-auth-test", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "../../../../packages/db/migrations/sqlite" }
  ]
}
