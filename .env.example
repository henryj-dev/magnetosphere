# Magnetosphere Compose 설치 환경 변수 (계획서 4.7, 7장). 실제 .env 는 손으로 만들지 말고 node scripts/init.mjs 로 만든다.
# init 은 비밀 값을 전부 무작위로 만들고, 이미 .env 가 있으면 덮지 않는다. 아래 빈 값은 init 이 채우는 자리다.

# ---------- Compose ----------
# 켤 DB 프로필: 비우면 SQLite, mysql 이면 MySQL 8.0, postgres 면 Postgres 14
COMPOSE_PROFILES=
# Caddy 사이트 주소. 도메인을 넣으면 HTTPS 인증서를 자동으로 받는다. :80 이면 HTTP 만
SITE_ADDRESS=:80
# Caddy 가 호스트에 여는 포트 (선택)
# HTTP_PORT=80
# HTTPS_PORT=443

# ---------- OmniRoute (V21) ----------
# 최초 대시보드 비밀번호. 유일한 필수 값. 회원 앱의 OmniRoute 부트스트랩도 이 값을 쓴다 (.env.setup 참고)
INITIAL_PASSWORD=
# 대시보드 세션 서명 키 (32자 이상)
JWT_SECRET=
# API 키 CRC 용 HMAC 비밀 값 (16자 이상)
API_KEY_SECRET=
# 제공자 자격 증명 암호화 키. 한 번 정하면 바꾸지 않는다 (바뀌면 OmniRoute 가 시작을 거부한다)
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_VERSION=v1
# 내부 WebSocket 브리지 인증 값
OMNIROUTE_WS_BRIDGE_SECRET=
# 키 없는 /v1 요청을 거부한다. OmniRoute 의 .env.example 은 false 라서 명시한다
REQUIRE_API_KEY=true
# 모델 가격표 외부 동기화
PRICING_SYNC_ENABLED=true

# ---------- 회원 앱 ----------
# 회원이 브라우저로 여는 공개 주소 (Better Auth baseURL, 신뢰 Origin)
BETTER_AUTH_URL=http://localhost
# Better Auth 비밀 값 (32자 이상)
BETTER_AUTH_SECRET=
# DB 에 넣는 비밀 값(OmniRoute 토큰·메일 키 등) 암호화 키. 32바이트 base64. 바뀌면 저장된 값을 못 읽는다
APP_ENCRYPTION_KEY=
# DB 주소. file:(SQLite) · mysql:// · postgres://
DATABASE_URL=file:/data/magnetosphere.sqlite
# X-Forwarded-For 를 믿을 프록시 (IP·CIDR, 쉼표 구분). Compose 기본값은 Caddy 만 있는 edge 망이다 (선택)
# TRUSTED_PROXIES=10.203.57.0/29

# ---------- DB 프로필 ----------
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
POSTGRES_PASSWORD=

# ---------- .env.setup (최초 설치 때만, 설치 뒤 지운다) ----------
# OMNIROUTE_INITIAL_PASSWORD=<INITIAL_PASSWORD 와 같은 값>
#   회원 앱이 OmniRoute 접근 토큰을 자동으로 만들 때 쓴다. 이 값으로 admin 토큰도 만들 수 있으므로 .env 에 두지 않는다.
#   설치가 끝나면: rm .env.setup && docker compose up -d app
