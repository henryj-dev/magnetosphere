{
  // 저장소 공통 TypeScript 설정. 패키지마다 tsconfig.json 이 이것을 extends 하고 pnpm -r typecheck 로 검사한다 (TC-S4.T3.d).
  // 소스는 빌드 없이 .ts 그대로 실행한다 (Node 타입 지우기·vitest·wrangler). tsc 는 검사만 한다.
  // erasableSyntaxOnly: Node 타입 지우기가 못 돌리는 문법(매개변수 속성·enum·namespace)을 막는다.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  }
}
